# Set unique local passwords before starting the database.
HAU_MAI_DB_PASSWORD=replace-with-a-strong-local-password
HAU_MAI_APP_PASSWORD=replace-with-another-strong-local-password

# Enables the local Zalo demo page; this does not connect a real Zalo OA.
ZALO_APP_ID=local-demo-app
ZALO_OA_WEBHOOK_SECRET=replace-with-a-random-local-secret
ZALO_DEMO_ENABLED=true
ZALO_SENDER=fake
